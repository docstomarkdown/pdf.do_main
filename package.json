{
  "name": "pdf-do-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare-assets": "node scripts/copy-assets.mjs",
    "dev": "npm run prepare-assets && next dev",
    "build": "npm run prepare-assets && next build",
    "serve": "serve out -l 4173 --no-clipboard -c ../serve.json",
    "fixtures": "node scripts/make-fixtures.mjs",
    "licenses": "node scripts/check-licenses.mjs",
    "test": "playwright test",
    "test:gallery": "playwright test -c playwright.gallery.config.ts",
    "colours": "node scripts/check-colours.mjs",
    "lint": "eslint && node scripts/check-colours.mjs"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "^2.11.1",
    "@neslinesli93/qpdf-wasm": "^0.3.1",
    "diff": "^9.0.0",
    "fflate": "^0.8.3",
    "hast-util-to-string": "^3.0.1",
    "lucide-react": "^1.70.0",
    "next": "^16.4.5",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "signature_pad": "^5.1.4",
    "sonner": "^2.0.8",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0",
    "yaml": "^2.9.1"
