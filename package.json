  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@fontsource/google-sans": "^5.3.2",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.4",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.5",
    "postcss": "^8.5.32",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.4",
    "typescript": "^6.0.3"
  }
